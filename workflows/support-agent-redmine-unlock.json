   "alwaysOutputData": true
  },
  {
   "parameters": {
    "operation": "getAll",
    "returnAll": true,
    "filters": {
     "project_id": "={{ $('Config').first().json.project_id }}",
     "tracker_id": "={{ $('Config').first().json.tracker_id }}",
