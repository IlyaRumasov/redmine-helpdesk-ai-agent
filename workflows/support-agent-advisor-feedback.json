   "id": "b52f21e9-10df-4647-8d8f-4692014956c7",
   "name": "[Data Table] Get Feedback",
   "alwaysOutputData": true,
   "executeOnce": true
  },
  {
   "parameters": {
    "jsCode": "const cfg = $('Config').first().json;\nconst since = Date.now() - Number(cfg.days_back) * 86400000;\nconst ids = [];\nfor (const { json: r } of $('[Data Table] Get Audit').all()) {\n  if (r.kind === 'advisor' && r.dry_run === false && r.ticket_id && Date.parse(r.at) >= since && !ids.includes(r.ticket_id)) ids.push(r.ticket_id);\n}\nreturn ids.slice(0, Number(cfg.max_tickets)).map(id => ({ json: { ticket_id: id } }));"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ],
   "id": "aaf663fb-0d6e-477c-a144-87743aabff86",
   "name": "Code: Tickets To Check"
  },
  {
   "parameters": {
    "operation": "get",
    "issueId": "={{ $json.ticket_id }}",
    "include": [
     "journals"
    ],
    "options": {}
   },
   "type": "n8n-nodes-redmine.redmine",
   "typeVersion": 1,
   "position": [
    1100,
    0
   ],
   "id": "5f86cde1-5c57-475f-9928-344dc073eb83",
   "name": "[Redmine] Get Ticket History",
   "credentials": {
    "redmineApi": {
     "id": "<REDMINE_CRED>",
     "name": "Redmine <ENV> account"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "const cfg = $('Config').first().json;\nconst have = new Set($('[Data Table] Get Feedback').all().map(i => String(i.json.journal_id)));\nconst rows = [];\nfor (const { json: h } of $input.all()) {\n  const issue = h.issue || h;\n  if (!issue.id) continue;\n  const js = (issue.journals || []).slice().sort((a, b) => String(a.created_on).localeCompare(String(b.created_on)));\n  const adv = js.find(j => String(j.notes || '').startsWith(cfg.advisor_prefix));\n  if (!adv) continue;\n  for (const j of js) {\n    if (String(j.created_on) <= String(adv.created_on) || have.has(String(j.id))) continue;\n    if (j.user && adv.user && String(j.user.id) === String(adv.user.id)) continue;  // не оцінки самого бота\n    const m = String(j.notes || '').trim().toLowerCase().match(/^(корисно|не те)(?=$|[\\s.,!:;)\\-–])/);\n    if (!m) continue;\n    rows.push({ json: { journal_id: j.id, ticket_id: issue.id, rating: m[1] === 'корисно' ? 'up' : 'down', comment: String(j.notes).trim().slice(0, 300),\n                        user_id: j.user ? j.user.id : 0, at: j.created_on, collected_at: new Date().toISOString() } });\n  }\n}\nreturn rows;"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
