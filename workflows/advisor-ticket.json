   "name": "Config"
  },
  {
   "parameters": {
    "jsCode": "const id = String($('When Called by Agent').first().json.ticket_id || '').trim();\nreturn [{ json: { ticket_id: /^\\d{1,9}$/.test(id) ? id : '0' } }];"
