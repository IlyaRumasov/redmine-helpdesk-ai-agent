   ],
   "id": "6a1dee23-11f6-454c-b638-dd49148a233e",
   "name": "[Redmine] Get Ticket",
   "credentials": {
    "redmineApi": {
     "id": "<ID>",
     "name": "<NAME>"
    }
   },
   "onError": "continueRegularOutput",
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "const cfg = $('Config').first().json;\nconst j = $input.first().json || {};\nconst t = j.issue || j;\nif (!t.id) return [{ json: { ok: false, error: 'заявку не знайдено або немає доступу' } }];\nif (String(t.project && t.project.id) !== String(cfg.project_id)) return [{ json: { ok: false, error: 'заявка не з проєкту HelpDesk' } }];\nconst cut = (s, n) => String(s || '').replace(/\\r/g, '').slice(0, n);\nconst notes = (t.journals || []).filter(x => (x.notes || '').trim()).slice(-30)\n  .map(x => ({ on: x.created_on, private: !!x.private_notes, text: cut(x.notes, Number(cfg.note_limit)) }));\nreturn [{ json: { ok: true, id: t.id, subject: cut(t.subject, 300), description: cut(t.description, Number(cfg.text_limit)),\n  status: t.status && t.status.name, created: t.created_on, notes } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ],
