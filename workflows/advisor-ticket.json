  },
  {
   "parameters": {
    "operation": "get",
    "issueId": "={{ $json.ticket_id }}",
    "include": [
     "journals"
    ],
    "options": {}
   },
   "type": "n8n-nodes-redmine.redmine",
   "typeVersion": 1,
   "position": [
    660,
