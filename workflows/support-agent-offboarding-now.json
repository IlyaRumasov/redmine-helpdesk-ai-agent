   "typeVersion": 1,
   "position": [
    1100,
    0
   ],
   "id": "9a23ba38-153f-4ff7-8745-b45af2ab8ecf",
   "name": "[Redmine] Get Ticket History",
   "credentials": {
    "redmineApi": {
     "id": "<REDMINE_CRED>",
     "name": "Redmine <ENV> account"
    }
   }
  },
  {
   "parameters": {
