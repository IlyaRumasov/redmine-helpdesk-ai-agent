          "leftValue": "={{ $json.flow }}",
          "rightValue": "linear",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "linear"
      },
