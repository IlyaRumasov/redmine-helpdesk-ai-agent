  {
   "parameters": {
    "jsCode": "// Відкриті заявки на звільнення, змінені нещодавно (може бути кілька сторінок, тут одна: за 15 хв їх небагато)\nreturn (($input.first().json.issues) || []).map(i => ({ json: { id: i.id, tracker_id: i.tracker && i.tracker.id, subject: i.subject } }));"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ],
   "id": "c335647a-a927-4c0f-b735-cfa7901952bc",
   "name": "Code: Split Issues"
  },
  {
