     "status": "1"
    },
    "options": {}
   },
   "type": "n8n-nodes-redmine.redmine",
   "typeVersion": 1,
   "position": [
    1320,
    0
   ],
   "id": "bee4b87a-0d4c-43d3-bf1e-52ba130a5d11",
   "name": "[Redmine] Get IT Admins",
   "credentials": {
    "redmineApi": {
     "id": "<REDMINE_CRED>",
     "name": "Redmine <ENV> account"
    }
   },
   "executeOnce": true,
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Шукаємо свіжу команду «Обробити зараз» від учасника «IT Адміни». Кожну команду (id запису журналу) виконуємо один раз.\nconst cfg = $('Config').first().json;\nconst words = String(cfg.command_words).toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nconst admins = new Set((($('[Redmine] Get IT Admins').first().json.users) || []).map(u => String(u.id)));\nconst done = new Set($('[Data Table] Get Log').all().filter(r => r.json.kind === 'offboarding_command').map(r => String(r.json.payload)));\nconst since = Date.now() - Number(cfg.window_minutes) * 60000;\nconst tracker = { [String(cfg.linear_tracker_id)]: 'linear', [String(cfg.admin_tracker_id)]: 'admin' };\nconst out = [];\nfor (const { json: h } of $('[Redmine] Get Ticket History').all()) {\n  const i = h.issue || h;\n  const flow = tracker[String(i.tracker && i.tracker.id)];\n  if (!flow) continue;\n  const cmd = (i.journals || []).filter(j => {\n    const n = String(j.notes || '').trim().toLowerCase().replace(/[.!\\s]+$/, '');\n    return words.includes(n) && Date.parse(j.created_on) >= since && admins.has(String(j.user && j.user.id));\n  }).pop();\n  if (!cmd || done.has(String(cmd.id))) continue;\n  out.push({ json: { ticket_id: i.id, flow, journal_id: cmd.id, by: cmd.user.name, at: new Date().toISOString() } });\n}\nreturn out;"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1540,
    0
   ],
   "id": "fc9df66d-76db-410e-ae1d-82cdc53707e3",
   "name": "Code: Find Commands"
  },
