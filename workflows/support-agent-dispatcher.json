   ],
   "id": "73521a44-e8eb-4816-82d5-071b9dd5665e",
   "name": "[Redmine] Get New Tickets",
   "credentials": {
    "redmineApi": {
     "id": "<REDMINE_CRED>",
     "name": "Redmine <ENV> account"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Нові нерозподілені заявки без запису в аудиті; тип за правилами, решта -> ІІ\nconst seen = new Set($('[Data Table] Get Processed').all().map(i => String(i.json.ticket_id)).filter(Boolean));\n// заявки авторів поза списком координаторів не чіпаємо взагалі (їхній текст не йде ні в інструменти, ні в ІІ)\nconst allowed = String($('Config').first().json.allowed_author_ids).split(',').map(s => s.trim()).filter(Boolean);\nconst tickets = ($input.first().json.issues || []).filter(t => !t.assigned_to && !seen.has(String(t.id))\n  && allowed.includes(String(t.author && t.author.id)));\nconst known = [], unknown = [];\nfor (const t of tickets) {\n  const text = `${t.subject}\\n${t.description || ''}`.toLowerCase();\n  let type = 'other';\n  if (/(розблок|разблок|unlock)/.test(text) && /(redmine|редмайн)/.test(text)) type = 'redmine_unlock';\n  else if (/змін\\S*\\s+особист\\S*\\s+пошт/.test(text)) type = 'mail_change';\n  else if (/(гостьов|guest acc|guest\\.google|google|гугл|gmail)/.test(text)\n           && /(2fa|2-step|двоетап|двохетап|двофактор|двухфакт|подвійн|backup|резервн|код|sign-in settings|верифікац|не може увійти|втрат\\S* доступ|відновлен\\S* доступ)/.test(text)) type = 'guest_codes';\n  else if (/(змін\\S*\\s+парол|скин\\S*\\s+парол|парол\\S*\\s+vpn)/.test(text)\n           || (/(заблок|розблок|locked out|account locked)/.test(text) && !/(redmine|редмайн|google|гугл|gmail|rivneshare|1с|1c)/.test(text))) type = 'password_reset';\n  (type === 'other' ? unknown : known).push({ ...t, route: type, via: 'rules' });\n}\nreturn [{ json: { known, unknown,\n  prompt_batch: JSON.stringify(unknown.map(t => ({ id: t.id, subject: String(t.subject).slice(0, 200),\n    text: String(t.description || '').replace(/\\s+/g, ' ').slice(0, 700) }))) } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ],
   "id": "e855101b-b55d-447b-a5bf-3e8001c172bd",
   "name": "Code: Rules Classify"
